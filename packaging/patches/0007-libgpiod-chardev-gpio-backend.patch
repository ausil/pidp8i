new file mode 100644
index 0000000..c39040f
--- /dev/null
+++ b/src/pinctrl/gpiolib-gpiod.c
@@ -0,0 +1,446 @@
+/*
+ * gpiolib-gpiod.c: libgpiod (chardev uAPI) backend for the gpiolib API
+ *
+ * Copyright © 2026 Dennis Gilmore and contributors
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+ * THE AUTHORS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER
+ * IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+ * CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+ *
+ * This file implements the same gpiolib.h interface as the vendored
+ * pinctrl gpiolib.c, but goes through the kernel GPIO character device
+ * via libgpiod instead of mmapping /dev/gpiomem.  Distro kernels without
+ * the Raspberry Pi firmware's gpiomem driver (Fedora, for one) have no
+ * /dev/gpiomem, so the pinctrl path cannot work there; the GPIO chardev
+ * is the only supported in-tree interface.  Configure with
+ * --enable-libgpiod to select this backend.
+ *
+ * Targets the libgpiod 2.x object API (struct gpiod_chip /
+ * gpiod_line_settings / gpiod_line_config / gpiod_line_request), which
+ * is what Fedora ships; the pre-2.0 line-handle API is gone.
+ *
+ * Semantics notes for the panel matrix code (see src/pidp8i/gpio-common.c.in):
+ *
+ *   - The lamp code writes values while the column pins are in input mode
+ *     (set_fsel INPUT, set_drive v, set_fsel OUTPUT) so the UDN2981 drivers
+ *     never see a glitched level.  That maps naturally onto chardev: while
+ *     a line's request is configured as input, set_drive only updates the
+ *     cache, and the cached value is applied as the output setting of the
+ *     reconfiguration that flips the line back to output.  Kernel-side
+ *     direction changes via gpiod_line_request_reconfigure_lines() are
+ *     single ioctls with no release window at all.
+ *
+ *   - The BCM2835 pull-up/down registers are independent of the direction
+ *     setting, so the original code's pull-up settings persist across the
+ *     repeated input/output flapping of the scan and paint loops, and pins
+ *     it never sets a pull on keep the SoC's power-on default.  We
+ *     reproduce that by requesting bias AS_IS (kernel leaves the pull
+ *     hardware alone) except when gpio_set_pull asked for a pull the
+ *     hardware doesn't already have.
+ *
+ *   - Alternate functions (FUNC0..8) are not expressible through the
+ *     chardev API, so entering one releases the line and lets the device
+ *     tree default (the I2C function, on the JLW serial-mod path) take
+ *     over again.
+ *
+ * Only the functions the PiDP-8/I GPIO modules actually call are
+ * implemented here; the rest of the pinctrl gpiolib.h surface (name
+ * lookups, pin-range queries, verbose hooks) is specific to the mmap
+ * backend and deliberately absent.
+ */
+
+#include <dirent.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <gpiod.h>
+
+#include "gpiolib.h"
+
+/*
+ * No source-level version guard: the configure script rejects builds
+ * whose libgpiod lacks the 2.x object API (it probes
+ * gpiod_chip_request_lines, which first appeared in 2.0).
+ */
+
+#define GPIOD_CONSUMER "pidp8i"
+
+//// PER-PIN STATE /////////////////////////////////////////////////////
+
+struct pin_state {
+    struct gpiod_line_request* req; // our request for this line, if held
+    GPIO_FSEL_T fsel;               // last function we asked the kernel for
+    GPIO_DRIVE_T drive;             // cached output value
+    GPIO_PULL_T pull;               // bias the caller asked for
+    int pull_set;                   // caller has called gpio_set_pull
+    int hw_pull;                    // 1 + bias last written to the
+                                    // kernel; 0 = unknown/never
+    int requested;                  // req != NULL, tracked explicitly
+};
+
+// FUNC0..FUNC8 are the alternate (non-GPIO) functions; INPUT, OUTPUT,
+// GPIO and NONE are all plain GPIO use, which we hold a request for.
+static int fsel_is_alt(GPIO_FSEL_T f)
+{
+    return f < GPIO_FSEL_INPUT;
+}
+
+static struct pin_state pins[MAX_GPIO_PINS];
+static struct gpiod_chip* chip;
+static struct gpiod_request_config* reqconf;   // consumer name, built once
+
+static struct pin_state* pin(unsigned gpio)
+{
+    if (gpio >= MAX_GPIO_PINS) return NULL;
+    return &pins[gpio];
+}
+
+static void die_hint(unsigned gpio, const char* op)
+{
+    fprintf(stderr, "pidp8i: gpio %u: %s failed: %s\n", gpio, op,
+            strerror(errno));
+    if (errno == EBUSY) {
+        fprintf(stderr, "pidp8i: hint: the line is claimed by another "
+                "driver; on a Pi 3-family board GPIOs 14/15 are the "
+                "Bluetooth UART. Try dtoverlay=disable-bt and disabling "
+                "the serial console.\n");
+    }
+}
+
+//// REQUEST (RE)CONFIGURATION /////////////////////////////////////////
+
+// Build a single-line config in the pin's cached state.  Caller frees.
+static struct gpiod_line_config* pin_line_config(struct pin_state* ps,
+                                                 unsigned gpio)
+{
+    struct gpiod_line_settings* s = gpiod_line_settings_new();
+    if (!s) return NULL;
+
+    // Bias: the BCM pull registers are independent of direction, and the
+    // mmap backend only ever writes them from gpio_set_pull.  Mirror
+    // that: leave the bias AS_IS (the kernel then doesn't touch the pull
+    // hardware at all) unless the caller asked for a pull that the
+    // hardware doesn't already have.  This keeps the BCM power-on
+    // pull-downs on the lamp row pins, which the panel never configures,
+    // and avoids a slow GPPUD sequence on every direction flip.
+    if (ps->fsel == GPIO_FSEL_OUTPUT) {
+        gpiod_line_settings_set_direction(s, GPIOD_LINE_DIRECTION_OUTPUT);
+        gpiod_line_settings_set_output_value(s,
+                ps->drive == DRIVE_HIGH ? GPIOD_LINE_VALUE_ACTIVE
+                                        : GPIOD_LINE_VALUE_INACTIVE);
+    }
+    else {   // INPUT, and GPIO_FSEL_GPIO/NONE (plain GPIO, stay tri-stated)
+        gpiod_line_settings_set_direction(s, GPIOD_LINE_DIRECTION_INPUT);
+    }
+    if (ps->pull_set && ps->hw_pull != (int) ps->pull + 1) {
+        switch (ps->pull) {
+            case PULL_UP:   gpiod_line_settings_set_bias(s, GPIOD_LINE_BIAS_PULL_UP);   break;
+            case PULL_DOWN: gpiod_line_settings_set_bias(s, GPIOD_LINE_BIAS_PULL_DOWN); break;
+            default:        gpiod_line_settings_set_bias(s, GPIOD_LINE_BIAS_DISABLED);  break;
+        }
+    }
+
+    struct gpiod_line_config* lc = gpiod_line_config_new();
+    if (!lc) { gpiod_line_settings_free(s); return NULL; }
+
+    unsigned offset = gpio;
+    int rc = gpiod_line_config_add_line_settings(lc, &offset, 1, s);
+    gpiod_line_settings_free(s);
+    if (rc != 0) { gpiod_line_config_free(lc); return NULL; }
+
+    return lc;
+}
+
+// Move the pin's kernel-side state to match its cached state.
+static int pin_apply(unsigned gpio, struct pin_state* ps)
+{
+    if (fsel_is_alt(ps->fsel)) {
+        // An alternate function: give the line back to the device tree.
+        if (ps->requested) {
+            gpiod_line_request_release(ps->req);
+            ps->req = NULL;
+            ps->requested = 0;
+        }
+        ps->hw_pull = 0;    // the alt function may have its own pull
+        return 0;
+    }
+
+    struct gpiod_line_config* lc = pin_line_config(ps, gpio);
+    if (!lc) {
+        die_hint(gpio, "line config");
+        return -1;
+    }
+
+    int ret;
+    if (ps->requested) {
+        // Single ioctl, no window where the line is unclaimed or floating.
+        ret = gpiod_line_request_reconfigure_lines(ps->req, lc);
+        if (ret != 0) die_hint(gpio, "reconfigure");
+    }
+    else {
+        ps->req = gpiod_chip_request_lines(chip, reqconf, lc);
+        if (!ps->req) {
+            die_hint(gpio, "request lines");
+            ret = -1;
+        }
+        else {
+            ps->requested = 1;
+            ret = 0;
+        }
+    }
+
+    gpiod_line_config_free(lc);
+    if (ret == 0 && ps->pull_set) ps->hw_pull = (int) ps->pull + 1;
+    return ret;
+}
+
+static void pin_set_fsel(unsigned gpio, GPIO_FSEL_T fsel)
+{
+    struct pin_state* ps = pin(gpio);
+    if (!ps) return;
+
+    ps->fsel = fsel;
+    pin_apply(gpio, ps);
+}
+
+//// GPIOLIB.H API /////////////////////////////////////////////////////
+
+static int is_gpiochip_entry(const struct dirent* de)
+{
+    return strncmp(de->d_name, "gpiochip", 8) == 0;
+}
+
+// Find the chip whose name or label is one of want_names, earlier
+// names winning.  libgpiod 2.x has no open-by-label, so we scan every
+// /dev/gpiochip* ourselves: there is no fixed upper bound on N (a Pi 5
+// has several brcmstb chips ahead of RP1, and laptops have a dozen
+// PMIC blocks).
+//
+// There is deliberately no "first chip that opens" fallback: the line
+// offsets we drive are BCM GPIO numbers, which only mean anything on
+// the SoC header controller.  Any other chip is a PMIC, expander or
+// similar, and toggling its lines is at best useless and at worst
+// harmful.  On a miss errno is the first open failure seen (EACCES
+// tells the caller to look at permissions), else ENODEV.
+static struct gpiod_chip* open_chip(const char* const* want_names)
+{
+    struct dirent** ents = NULL;
+    int nents = scandir("/dev", &ents, is_gpiochip_entry, alphasort);
+    if (nents < 0) return NULL;
+
+    struct gpiod_chip* found = NULL;
+    int found_rank = -1;
+    int real_err = 0;
+    char path[300];
+
+    for (int i = 0; i < nents; ++i) {
+        snprintf(path, sizeof path, "/dev/%s", ents[i]->d_name);
+        if (!gpiod_is_gpiochip_device(path)) continue;
+
+        struct gpiod_chip* c = gpiod_chip_open(path);
+        if (!c) {
+            if (!real_err && errno != ENOENT) real_err = errno;
+            continue;
+        }
+
+        int rank = -1;
+        struct gpiod_chip_info* info = gpiod_chip_get_info(c);
+        if (info) {
+            const char* nm = gpiod_chip_info_get_name(info);
+            const char* lb = gpiod_chip_info_get_label(info);
+            for (int r = 0; want_names[r]; ++r) {
+                if ((nm && strcmp(nm, want_names[r]) == 0) ||
+                    (lb && strcmp(lb, want_names[r]) == 0)) {
+                    rank = r;
+                    break;
+                }
+            }
+            gpiod_chip_info_free(info);
+        }
+
+        if (rank >= 0 && (found_rank < 0 || rank < found_rank)) {
+            if (found) gpiod_chip_close(found);
+            found = c;
+            found_rank = rank;
+        }
+        else {
+            gpiod_chip_close(c);
+        }
+    }
+
+    for (int i = 0; i < nents; ++i) free(ents[i]);
+    free(ents);
+
+    if (!found) errno = real_err ? real_err : ENODEV;
+    return found;
+}
+
+int gpiolib_init(void)
+{
+    // GPIO chip labels of the 40-pin header controller, as registered by
+    // the mainline drivers (and the Raspberry Pi kernel, which uses the
+    // same labels): Pi 0-3, Pi 4/400/CM4 (same driver, different label),
+    // Pi 5/CM5 (RP1, behind PCIe).
+    static const char* const names[] = {
+        "pinctrl-bcm2835", "pinctrl-bcm2711", "pinctrl-rp1", NULL };
+
+    chip = open_chip(names);
+    if (!chip) {
+        fprintf(stderr, "pidp8i: cannot open the Raspberry Pi header GPIO "
+                "chip (pinctrl-bcm2835/-bcm2711/-rp1): %s\n",
+                strerror(errno));
+        if (errno == ENODEV) {
+            fprintf(stderr, "pidp8i: hint: no GPIO chip with one of those "
+                    "labels is visible; compare gpiodetect(1). On a Pi 5 "
+                    "the RP1 drivers are modules (rp1_pci, pinctrl-rp1).\n");
+        }
+        if (errno == EACCES) {
+            fprintf(stderr, "pidp8i: hint: check who may open the node: "
+                    "ls -l /dev/gpiochip* (99-pidp8i.rules assigns the "
+                    "panel chip to group pidp8i); SELinux: ausearch avc.\n");
+        }
+        return -EIO;
+    }
+
+    reqconf = gpiod_request_config_new();
+    if (reqconf) gpiod_request_config_set_consumer(reqconf, GPIOD_CONSUMER);
+
+    struct gpiod_chip_info* info = gpiod_chip_get_info(chip);
+    int num = 0;
+    if (info) {
+        num = (int) gpiod_chip_info_get_num_lines(info);
+        gpiod_chip_info_free(info);
+    }
+    if (num <= 0) {
+        fprintf(stderr, "pidp8i: GPIO chip reports no lines\n");
+        return -ENODEV;
+    }
+    return num;
+}
+
+int gpiolib_init_by_name(const char* name)
+{
+    chip = gpiod_chip_open(name);       // a /dev/gpiochipN path, or...
+    if (!chip) {
+        const char* const names[] = { name, NULL };
+        chip = open_chip(names);        // ...a chip name/label
+    }
+    if (!chip) {
+        fprintf(stderr, "pidp8i: cannot open GPIO chip '%s': %s\n",
+                name, strerror(errno));
+        return -EIO;
+    }
+
+    reqconf = gpiod_request_config_new();
+    if (reqconf) gpiod_request_config_set_consumer(reqconf, GPIOD_CONSUMER);
+
+    struct gpiod_chip_info* info = gpiod_chip_get_info(chip);
+    int num = info ? (int) gpiod_chip_info_get_num_lines(info) : 0;
+    if (info) gpiod_chip_info_free(info);
+    return num > 0 ? num : -ENODEV;
+}
+
+// The chardev backend has no peripheral mapping step; succeed silently.
+int gpiolib_mmap(void)
+{
+    return chip ? 0 : -EIO;
+}
+
+int gpio_num_is_valid(unsigned gpio)
+{
+    if (!chip) return 0;
+    struct gpiod_chip_info* info = gpiod_chip_get_info(chip);
+    if (!info) return 0;
+    int ok = gpio < gpiod_chip_info_get_num_lines(info);
+    gpiod_chip_info_free(info);
+    return ok;
+}
+
+void gpio_set_dir(unsigned gpio, GPIO_DIR_T dir)
+{
+    pin_set_fsel(gpio, dir == DIR_OUTPUT ? GPIO_FSEL_OUTPUT
+                                         : GPIO_FSEL_INPUT);
+}
+
+void gpio_set_fsel(unsigned gpio, const GPIO_FSEL_T func)
+{
+    pin_set_fsel(gpio, func);
+}
+
+void gpio_set_drive(unsigned gpio, GPIO_DRIVE_T drv)
+{
+    struct pin_state* ps = pin(gpio);
+    if (!ps) return;
+
+    ps->drive = drv;
+
+    // Only touch hardware if the line currently drives the pin; while
+    // blanked to input this just updates the value the next output
+    // reconfiguration will apply.
+    if (ps->requested && ps->fsel == GPIO_FSEL_OUTPUT) {
+        // The second argument is the chip line offset even though the
+        // request holds one line: libgpiod keys requested lines by
+        // their chip-side offset (passing an index yields EINVAL for
+        // every pin but gpio 0 - learned the hard way on real
+        // hardware).
+        if (gpiod_line_request_set_value(ps->req, gpio,
+                                         drv == DRIVE_HIGH) != 0) {
+            die_hint(gpio, "set value");
+        }
+    }
+}
+
+void gpio_set(unsigned gpio)   { gpio_set_drive(gpio, DRIVE_HIGH); }
+void gpio_clear(unsigned gpio) { gpio_set_drive(gpio, DRIVE_LOW);  }
+
+void gpio_set_pull(unsigned gpio, GPIO_PULL_T pull)
+{
+    struct pin_state* ps = pin(gpio);
+    if (!ps) return;
+
+    ps->pull = pull;
+    ps->pull_set = 1;
+
+    // Apply immediately whenever we hold the line, matching the mmap
+    // backend, where the pull registers take effect regardless of the
+    // direction.  Otherwise the next request picks it up.
+    if (ps->requested) pin_apply(gpio, ps);
+}
+
+int gpio_get_level(unsigned gpio)
+{
+    struct pin_state* ps = pin(gpio);
+    if (!ps) return 0;
+
+    // The scan loop sets input mode before reading, but don't depend on
+    // it: sampling the pin requires an input-side request, so force that
+    // state if we're not already in it.
+    if (!ps->requested || ps->fsel == GPIO_FSEL_OUTPUT) {
+        ps->fsel = GPIO_FSEL_INPUT;
+        if (pin_apply(gpio, ps) != 0) return 0;
+    }
+    if (!ps->requested) return 0;
+
+    // Chip line offset, not a within-request index - see gpio_set_drive.
+    int value = gpiod_line_request_get_value(ps->req, gpio);
+    if (value < 0) {
+        die_hint(gpio, "get value");
+        return 0;
+    }
+    return value ? 1 : 0;
+}
